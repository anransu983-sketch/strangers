# MyProbe 服务端配置（复制为 .env 后修改）
# Agent 上报密钥：改成随机长字符串，所有 agent 共用
MYPROBE_TOKEN=CHANGE_ME_随机长字符串

# 管理员账号（看板改名/删除节点用）
MYPROBE_ADMIN_USER=admin
MYPROBE_ADMIN_PASS=CHANGE_ME_强密码

# Flask 会话密钥（留空则每次重启随机生成，登录会失效；建议填一个随机值）
MYPROBE_SECRET=

# 数据文件位置
MYPROBE_DB=/opt/myprobe/data/myprobe.db

# 监听端口（nginx 反代到这个端口）
MYPROBE_PORT=17234

# 期望上报间隔（秒），需与 agent 的 --interval 一致
MYPROBE_INTERVAL=5
